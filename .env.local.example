NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: public URL encoded in the /beta/qr code. Defaults to the host serving the page.
NEXT_PUBLIC_SITE_URL=

# --- AI model keys (server only: never prefix with NEXT_PUBLIC_) -----------------
# One key per feature and provider, so usage shows separately in each console:
#   Groq: one project per feature        (console.groq.com)
#   Claude: one workspace per feature    (platform.claude.com)
# Create a separate key per environment (dev / staging / production) inside each.
# Check them with: npm run ai:check
AI_ONBOARDING_GROQ_API_KEY=
AI_ONBOARDING_ANTHROPIC_API_KEY=
AI_MESSAGING_GROQ_API_KEY=
AI_MESSAGING_ANTHROPIC_API_KEY=
# Evals and benchmarks: dev only, keeps test spend out of the real features.
AI_EVALS_GROQ_API_KEY=
AI_EVALS_ANTHROPIC_API_KEY=

# Optional: override the default models (final choice comes from the week 6 benchmark).
# AI_FAST_MODEL=openai/gpt-oss-120b
# AI_FRONTIER_MODEL=claude-sonnet-5-5

# Optional: AI_STUB=1 answers every model call with a stub. No keys needed, no spend.
# AI_STUB=1
